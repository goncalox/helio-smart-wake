{
  "id": "helio_awake_after_rest_v1",
  "alias": "Helio \u2014 Ready to get up",
  "description": "Sends one gentle strap alarm only after you are already Awake and have at least the configured recorded sleep duration (7h30 by default), excluding recorded awake minutes.\n\nRequires fresh Awake from either the strap OR our model; Light alone never qualifies.\n\nUses Home Assistant data changes and a once-per-minute clock check, requesting minute reads near the threshold.\n\nAsks the integration to save and verify a cue at least 30 seconds ahead, rounded up to a minute.\n\nThere is no full-target alarm, deadline or repeating reminder; if qualifying Awake data never arrives, it stays silent.\n\nSaved state and instruction receipts prevent duplicate cues after restart; manual alarm control pauses the night, and switching smart wake off cancels this routine\u2019s future cue.",
  "mode": "queued",
  "max": 10,
  "max_exceeded": "silent",
  "trace": {
    "stored_traces": 20
  },
  "triggers": [
    {
      "trigger": "state",
      "entity_id": [
        "sensor.helio_smart_wake_sleep_observations",
        "sensor.helio_smart_wake_alarm_instructions",
        "binary_sensor.helio_smart_wake_bridge_connected",
        "switch.helio_smart_wake_smart_wake",
        "input_number.helio_ready_to_get_up_sleep_hours"
      ]
    },
    {
      "trigger": "time_pattern",
      "minutes": "/1",
      "seconds": "0"
    },
    {
      "trigger": "homeassistant",
      "event": "start"
    }
  ],
  "conditions": [
    {
      "condition": "state",
      "entity_id": "binary_sensor.helio_smart_wake_bridge_connected",
      "state": "on"
    },
    {
      "condition": "state",
      "entity_id": "sensor.helio_smart_wake_owner",
      "state": "Home Assistant"
    }
  ],
  "actions": [
    {
      "variables": {
        "clock": "{{ now().timestamp() | int }}",
        "d": "{{ states['sensor.helio_smart_wake_sleep_observations'].attributes | default({},true) | to_json | from_json }}",
        "commands": "{{ states['sensor.helio_smart_wake_alarm_instructions'].attributes | default({},true) | to_json | from_json }}",
        "old": "{{ (states('input_text.helio_awake_cue_session')[4:] | from_json({})) if states('input_text.helio_awake_cue_session').startswith('AC1:') else {} }}",
        "threshold": "{{ states(\"input_number.helio_ready_to_get_up_sleep_hours\") | float(7.5) * 3600 }}"
      }
    },
    {
      "variables": {
        "night": "{{ d.get(\"night\",0) | int }}",
        "manual": "{{ commands.get(\"manual\",0) | int }}",
        "last": "{{ commands.get(\"last_instruction\",{}) }}",
        "verified": "{{ commands.get(\"verified_epoch\",0) | int }}"
      }
    },
    {
      "variables": {
        "s": "{{ old if old.get(\"n\",0)==night else dict(n=night,p=0,m=manual,c=0,x=0) }}"
      }
    },
    {
      "if": [
        {
          "condition": "template",
          "value_template": "{{ night>0 and old.get(\"n\",0)!=night }}"
        }
      ],
      "then": [
        {
          "alias": "Save the dated cue state",
          "action": "input_text.set_value",
          "target": {
            "entity_id": "input_text.helio_awake_cue_session"
          },
          "data": {
            "value": "{{ 'AC1:' ~ (s | to_json) }}"
          }
        }
      ]
    },
    {
      "alias": "Recover an accepted cue if the helper update was interrupted",
      "if": [
        {
          "condition": "template",
          "value_template": "{{ last.get(\"context\",{}).get(\"routine\",\"\")==\"helio_awake_after_rest_v1\" and last.get(\"context\",{}).get(\"awake_cue_state\",{}).get(\"n\",0)==night and last.get(\"context\",{}).get(\"awake_cue_state\",{}).get(\"m\",-1)==manual and last.get(\"command_id\",0)>s.c }}"
        }
      ],
      "then": [
        {
          "variables": {
            "s": "{{ dict(last.context.awake_cue_state,c=last.command_id) }}"
          }
        },
        {
          "alias": "Save the dated cue state",
          "action": "input_text.set_value",
          "target": {
            "entity_id": "input_text.helio_awake_cue_session"
          },
          "data": {
            "value": "{{ 'AC1:' ~ (s | to_json) }}"
          }
        }
      ]
    },
    {
      "if": [
        {
          "condition": "template",
          "value_template": "{{ s.m!=manual }}"
        }
      ],
      "then": [
        {
          "variables": {
            "s": "{{ dict(s,m=manual,x=2) }}"
          }
        },
        {
          "alias": "Save the dated cue state",
          "action": "input_text.set_value",
          "target": {
            "entity_id": "input_text.helio_awake_cue_session"
          },
          "data": {
            "value": "{{ 'AC1:' ~ (s | to_json) }}"
          }
        }
      ]
    },
    {
      "alias": "Stop or cancel when smart wake is switched off",
      "choose": [
        {
          "conditions": [
            {
              "condition": "state",
              "entity_id": "switch.helio_smart_wake_smart_wake",
              "state": "off"
            }
          ],
          "sequence": [
            {
              "condition": "template",
              "value_template": "{{ not commands.get(\"pending\",false) }}"
            },
            {
              "if": [
                {
                  "condition": "template",
                  "value_template": "{{ s.p>clock and verified==s.p and last.get(\"context\",{}).get(\"routine\",\"\")==\"helio_awake_after_rest_v1\" }}"
                }
              ],
              "then": [
                {
                  "variables": {
                    "next_state": "{{ dict(s,x=4) }}"
                  }
                },
                {
                  "alias": "Cancel this routine\u2019s future cue",
                  "action": "helio_smart_wake.cancel_alarm",
                  "data": {
                    "request_id": "{{ 'awake-cue-' ~ s.n ~ '-off-' ~ s.p ~ '-' ~ manual }}",
                    "context": {
                      "routine": "helio_awake_after_rest_v1",
                      "awake_cue_state": "{{ next_state }}",
                      "follow": false,
                      "reason": "cue-off"
                    }
                  },
                  "response_variable": "receipt"
                },
                {
                  "variables": {
                    "s": "{{ dict(next_state,c=receipt.command_id) }}"
                  }
                },
                {
                  "alias": "Save the dated cue state",
                  "action": "input_text.set_value",
                  "target": {
                    "entity_id": "input_text.helio_awake_cue_session"
                  },
                  "data": {
                    "value": "{{ 'AC1:' ~ (s | to_json) }}"
                  }
                }
              ]
            },
            {
              "stop": "Smart wake is off"
            }
          ]
        }
      ]
    },
    {
      "condition": "template",
      "value_template": "{{ night>0 and not s.p and not s.x and not commands.get(\"pending\",false) }}"
    },
    {
      "variables": {
        "onset": "{{ d.get(\"onset\",0) | int }}",
        "awake": "{{ d.get(\"awake\",0) | int }}"
      }
    },
    {
      "alias": "Request faster reads near the recorded-sleep threshold",
      "if": [
        {
          "condition": "template",
          "value_template": "{{ onset>0 and clock<d.get(\"session_end\",0) and clock-onset-awake*60>=threshold-900 }}"
        }
      ],
      "then": [
        {
          "action": "helio_smart_wake.refresh",
          "data": {
            "frequent": true
          }
        }
      ]
    },
    {
      "alias": "Require enough complete recorded sleep and a fresh explicit Awake stage",
      "condition": "template",
      "value_template": "{{ onset>0 and onset>=night and threshold>=6*3600 and threshold<=10*3600 and d.get(\"band_valid\",false) and d.get(\"complete\",false) and not d.get(\"nap\",true) and d.get(\"raw_onset\",0)==onset and d.get(\"raw_awake\",-1)==awake and d.get(\"through\",0)-onset-awake*60>=threshold and d.get(\"through\",0)<=clock and d.get(\"through\",0)>=clock-180 and d.get(\"read_at\",0)<=clock and d.get(\"read_at\",0)>=clock-90 and (d.get(\"band_stage\",0)==7 or (d.get(\"model_valid\",false) and d.get(\"model_stage\",0)==7 and d.get(\"model_sample\",0)<=clock and d.get(\"model_sample\",0)>=clock-180 and d.get(\"model_read_at\",0)<=clock and d.get(\"model_read_at\",0)>=clock-90 and ((d.get(\"model_sample\",0)+60-d.get(\"through\",0)) | abs)<=60)) and (not verified or verified>=clock+30) }}"
    },
    {
      "variables": {
        "cue_time": "{{ ((clock+89)//60)*60 }}"
      }
    },
    {
      "variables": {
        "next_state": "{{ dict(s,p=cue_time) }}"
      }
    },
    {
      "alias": "Save and verify one get-up cue on the strap",
      "action": "helio_smart_wake.set_alarm",
      "data": {
        "when": "{{ cue_time }}",
        "request_id": "{{ 'awake-cue-' ~ s.n ~ '-awake-' ~ cue_time ~ '-' ~ manual }}",
        "context": {
          "routine": "helio_awake_after_rest_v1",
          "awake_cue_state": "{{ next_state }}",
          "follow": false,
          "reason": "awake-after-rest"
        }
      },
      "response_variable": "receipt"
    },
    {
      "variables": {
        "s": "{{ dict(next_state,c=receipt.command_id) }}"
      }
    },
    {
      "alias": "Save the dated cue state",
      "action": "input_text.set_value",
      "target": {
        "entity_id": "input_text.helio_awake_cue_session"
      },
      "data": {
        "value": "{{ 'AC1:' ~ (s | to_json) }}"
      }
    }
  ]
}
